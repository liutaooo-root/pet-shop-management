# 服务器
PORT=3000
NODE_ENV=production

# ==================== PostgreSQL 数据库 ====================

# 本地开发
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=pet_shop_db

# Supabase 部署（在 Supabase Dashboard → Settings → Database 获取）
# PGHOST=db.xxxx.supabase.co
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_supabase_db_password
# PGDATABASE=postgres

# Railway PostgreSQL 插件（自动注入）
# PGHOST=xxx
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=xxx
# PGDATABASE=railway